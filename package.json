{
  "name": "apollo-server",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun run build:docs && tsc -p tsconfig.build.json",
    "build:docs": "tsx scripts/build-docs.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "SKIP_DB_TESTS=1 vitest run",
    "test:ci:coverage": "SKIP_DB_TESTS=1 vitest run --coverage",
    "smoke": "vitest run tests/smoke",
    "smoke:http": "SMOKE_HTTP=1 vitest run tests/smoke/http-smoke.test.ts",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@logtail/pino": "^0.5.8",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sentry/node": "^10.48.0",
    "apollo-server": ".",
    "better-auth": "^1.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "geotiff": "^3.0.5",
    "graphql": "^16.13.0",
    "graphql-tag": "^2.12.6",
    "graphql-upload": "^17.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^5.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-tools/schema": "^10.0.31",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/graphql-upload": "^17.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.2",
    "@types/nodemailer": "^7.0.11",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^10.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
