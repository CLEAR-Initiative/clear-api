# Application
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL="postgres://user:password@host:port/database"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL=http://localhost:4000

# Frontend URL (for email links — invitations, password reset)
FRONTEND_URL=http://localhost:3000

# Email Provider: "smtp" or "postmark"
EMAIL_PROVIDER=smtp

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@clear-platform.org

# Postmark Configuration (when EMAIL_PROVIDER=postmark)
# POSTMARK_SERVER_TOKEN=
# POSTMARK_SENDER_EMAIL=

# Celery broker (Redis) — shared with clear-pipeline for task dispatch
CELERY_BROKER_URL=redis://localhost:6379/0

# S3 — Railway Object Storage (media uploads)
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Global admin seed credentials (env overrides seed defaults)
ADMIN_EMAIL=admin@clear.dev
ADMIN_PASSWORD=password123

LOCATIONIQ_API_KEY=""

# Exponential CRM integration — pushes new signups into the prospects
# collection (CRM only; the ack email is sent by clear-api) and moves
# approved users into the approved collection (fires the welcome email)
# from the `/portal/admin` approve action. All values are optional in
# dev: if any of API_URL / JWT / WORKSPACE_ID is missing, the CRM calls
# silently degrade to no-ops, signups + approvals still work locally.
EXPONENTIAL_API_URL=
# Long-lived JWT bearer issued by Exponential's auth secret. Must
# resolve to a user that is a member of the Clear workspace with edit
# rights on the prospects + approved collections.
EXPONENTIAL_JWT=
EXPONENTIAL_WORKSPACE_ID=
# Collection holding pending-approval contacts. Members are added here
# from Better Auth's user.create.after hook on each signup (CRM only —
# the acknowledgement email is sent by clear-api, CLEAR-branded).
# Disable Exponential's collection-join automation for this list or
# signups receive a second ack from Exponential Support.
EXPONENTIAL_PROSPECTS_COLLECTION_ID=
# Collection holding admin-approved contacts. The approve action moves
# the contact from prospects into here, which triggers the welcome
# automation on Exponential's side.
EXPONENTIAL_APPROVED_COLLECTION_ID=

# Buttondown newsletter — subscriber count on `/portal/admin` dashboard.
# Optional in dev; when absent the dashboard shows "not configured".
BUTTONDOWN_API_KEY=

# ─── Knowledge-base embedding provider ─────────────────────────────
# The `searchKnowledgebase` query embeds the incoming search string
# via the same provider + model dagster-quickstart used to embed the
# stored chunks — cross-provider cosine distances are meaningless, so
# the write and read sides MUST agree. Keep these values in sync with
# dagster-quickstart's .env.
#
# Supported PROVIDER values:
#   voyage        — Voyage AI REST (uses input_type="query" for
#                   asymmetric embedding).
#   openai_compat — /v1/embeddings on any OpenAI-compatible endpoint
#                   (Together AI, Fireworks, HuggingFace TEI, vLLM).
#                   Requires EMBEDDING_BASE_URL.
#
# EMBEDDING_DIMENSIONS MUST equal the pgvector column dimension
# (currently 1024). Changing it is a coordinated migration.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=              # REQUIRED only when PROVIDER=openai_compat

# ─── Dagster (knowledge-base manual ingest trigger) ────────────────
# Used by `uploadKnowledgebaseDocument` to hand off freshly uploaded
# PDFs to the `process_manual_document_job` in dagster-quickstart.
# Optional in dev: when DAGSTER_URL is unset the mutation still
# stages the PDF in S3 and returns a UNKNOWN-status job (no run
# launched) — useful when Dagster is offline.
#
# LOCATION_NAME / REPOSITORY_NAME must match what `dg dev` reports.
# Query them once via:
#   curl -s $DAGSTER_URL/graphql \
#     -H 'Content-Type: application/json' \
#     -d '{"query":"{ repositoryLocations { __typename ... on RepositoryLocation { name repositories { name } } } }"}'
DAGSTER_URL=http://localhost:3000
DAGSTER_REPOSITORY_LOCATION_NAME=clear-pipeline
DAGSTER_REPOSITORY_NAME=__repository__
