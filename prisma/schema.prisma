generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AlertStatus {
  draft
  published
  archived

  @@map("alert_status")
}

enum DetectionStatus {
  raw
  processed
  ignored

  @@map("detection_status")
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  READ

  @@map("notification_status")
}

enum Channel {
  email
  sms
}

enum Frequency {
  immediately
  daily
  weekly
  monthly
}

// ─── Auth (Better Auth) ────────────────────────────────────────────────────

model user {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  phoneNumber   String? @map("phone_number")
  image         String?
  role          String  @default("viewer")
  isActive      Boolean @default(true) @map("is_active")
  language      String  @default("en")

  inAppNotification Boolean @default(false) @map("in_app_notification")
  emailNotification Boolean @default(false) @map("email_notification")
  smsNotification   Boolean @default(false) @map("sms_notification")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  sessions session[]
  accounts account[]

  defaultTeamId String? @map("default_team_id")
  defaultTeam   teams?  @relation("DefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)

  alerts                userAlerts[]
  apiKeys               apiKeys[]
  notifications         notifications[]
  organisations         organisationUsers[]
  teamMemberships       teamMembers[]
  eventEscaladedByUsers eventEscaladedByUsers[]
  userFeedbacks         userFeedbacks[]
  userComments          userComments[]
  commentTags           commentTags[]
  invitationsSent       invitations[]           @relation("InvitedBy")
  activityLogs          activityLogs[]
}

/// Append-only audit / analytics log. Every meaningful user-initiated
/// action (login, manual signal / event / alert / crisis / feedback
/// creation, etc.) writes one row here. The admin dashboard reads it to
/// surface activity stats and per-user usage. Logging is best-effort:
/// the `logActivity()` helper swallows any error so a write failure can
/// never break the original action.
model activityLogs {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// Namespaced verb identifier, e.g. `auth.login`, `signal.create_manual`,
  /// `event.create`, `alert.create`, `crisis.create`, `feedback.create`.
  /// Use dot-separated `<resource>.<verb>[_<qualifier>]` so the dashboard
  /// can filter by prefix.
  action String

  /// Coarse resource bucket — `signal`, `event`, `alert`, `crisis`,
  /// `feedback`, `session`. Redundant with `action` but cheap to filter on.
  resourceType String? @map("resource_type")

  /// The created/affected row's id. Null for actions like login.
  resourceId String? @map("resource_id")

  /// Free-form per-action context (title, severity, signal source, etc.).
  /// Keep small — anything load-bearing belongs in a typed column.
  metadata Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

/// Per-locale translation overlay shared across every translatable entity.
/// One row per (entity, locale); the same shape regardless of entity type so
/// new translatable models can be added without a schema migration.
///
/// `data` mirrors the canonical entity's JSON shape exactly — e.g. for a
/// crisis it carries the localized `{ title, summary, scenarios, needs }`
/// with the same keys/nesting the API already returns in English. Resolvers
/// overlay `data` on top of the canonical row so callers can read
/// `crisis.scenarios.most_likely` the same way regardless of locale.
///
/// `sourceHashes` are per-top-level-field so the pipeline can detect which
/// canonical field changed (e.g. user-edited title) and only re-translate
/// the affected field per locale instead of regenerating the whole blob.
///
/// No SQL foreign key — `entityId` is polymorphic across (event, crisis,
/// location). Cleanup on delete is handled in the app layer; dangling
/// translations are harmless (nothing reads them) and can be GC'd by a
/// periodic job if they ever accumulate.
model translations {
  id String @id @default(cuid())

  /// Discriminator: 'event' | 'crisis' | 'location' (extend as needed).
  /// Kept alongside the typed FK columns below for backwards compat with
  /// older write paths and the admin `entitiesMissingTranslation` query.
  /// New code should prefer the typed relations.
  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  /// Typed nullable foreign keys per entity type. Exactly one is non-null
  /// (CHECK constraint in the migration), matching `entityType`/`entityId`.
  /// These enable Prisma's `include: { translations: { where: { locale } } }`
  /// to fold the translation lookup into the entity's main query — the read
  /// path before this lived in `utils/translation-loader.ts` as a separate
  /// `findMany`, and at non-English locales the additional roundtrip plus
  /// the lazy-on-read enqueue side-effect saturated the resolver fan-out
  /// for list views (see 2026-06-17 incident).
  eventId    String? @map("event_id")
  crisisId   String? @map("crisis_id")
  locationId String? @map("location_id")

  event    events?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  crisis   crises?    @relation(fields: [crisisId], references: [id], onDelete: Cascade)
  location locations? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// BCP-47 code (lowercased) — 'ar', 'fr', etc. Matches the
  /// `user.language` field; the resolver context derives locale from there.
  locale String

  data         Json
  sourceHashes Json? @map("source_hashes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Primary read path is "give me locale X for entity (type, id)" — the
  /// uniqueness constraint covers that with a btree without an extra index.
  @@unique([entityType, entityId, locale])
  /// Per-FK uniqueness: enforce one row per (entity, locale) without
  /// relying on the polymorphic columns. Partial-unique via the
  /// migration's WHERE clause so the NULL FK columns don't all collide.
  @@unique([eventId, locale])
  @@unique([crisisId, locale])
  @@unique([locationId, locale])
  /// Secondary admin queries ("what's covered in Arabic?") use this.
  @@index([entityType, locale])
  @@map("translations")
}

model session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")
}

// ––– Organisation ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––

model organisations {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       organisationUsers[]
  teams       teams[]
  invitations invitations[]
}

model organisationUsers {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organisationId String   @map("organisation_id")
  role           String   @default("member") // org_admin | member (legacy: owner, admin → org_admin — see migration)
  createdAt      DateTime @default(now()) @map("created_at")

  user         user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation organisations @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@map("user_to_organisation")
}

// ––– Teams –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––

model teams {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation    organisations     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members         teamMembers[]
  locations       teamLocations[]
  defaultForUsers user[]            @relation("DefaultTeam")
  invitations     invitations[]
  invitationTeams invitationTeams[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model teamMembers {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   @default("team_member") // team_admin | field_coordinator | team_member (legacy: lead → team_admin, analyst → field_coordinator, viewer → team_member — see migration)
  createdAt DateTime @default(now()) @map("created_at")

  team teams @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user user  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model teamLocations {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  team     teams     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  location locations @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([teamId, locationId])
  @@index([locationId])
  @@map("team_locations")
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model invitations {
  id             String    @id @default(cuid())
  email          String
  organisationId String    @map("organisation_id")
  /// Legacy single-team fields (kept for back-compat with rows created before
  /// `invitationTeams` existed). New invites use the join table — these stay
  /// null on multi-team invites.
  teamId         String?   @map("team_id")
  role           String    @default("member") // org role: org_admin | member (legacy: owner, admin → org_admin — see migration)
  teamRole       String?   @map("team_role") // team role: team_admin | field_coordinator | team_member (legacy: lead → team_admin, analyst → field_coordinator, viewer → team_member — see migration)
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  invitedById    String    @map("invited_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation organisations     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  team         teams?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy    user              @relation("InvitedBy", fields: [invitedById], references: [id])
  /// Multi-team assignments (each row is one (team, role) pair).
  teams        invitationTeams[]

  @@index([email])
  @@index([organisationId])
  @@map("invitations")
}

/// One row per (invitation, team) — lets a single invitation grant access to
/// multiple teams with different roles per team.
model invitationTeams {
  id           String @id @default(cuid())
  invitationId String @map("invitation_id")
  teamId       String @map("team_id")
  /// Team role: team_admin | field_coordinator | team_member. Stored as a
  /// string to mirror teamMembers.role semantics; the GraphQL enum lives in
  /// the typedefs. Legacy values (lead / analyst / viewer) were folded into
  /// the new set by the Phase-3 backfill.
  teamRole     String @map("team_role")

  invitation invitations @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  team       teams       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([invitationId, teamId])
  @@index([teamId])
  @@map("invitation_teams")
}

// ─── Geography ───────────────────────────────────────────────────────────────

model locations {
  id          String                                  @id @default(cuid())
  geoId       Int?                                    @map("geonames_id")
  osmId       BigInt?                                 @map("osm_id")
  pCode       String?                                 @map("p_code") @db.VarChar(50)
  geometry    Unsupported("geometry(Geometry, 4326)") // use CHECK (GeometryType(geometry) IN ('POINT', 'MULTIPOLYGON'))
  name        String
  level       Int
  parentId    String?                                 @map("parent_id")
  ancestorIds String[]                                @map("ancestor_ids")
  /// Population residing within this location's geometry (from WorldPop raster).
  /// Populated by a background worker for admin levels 0-2. Null for point locations.
  population  BigInt?

  /// Provenance tag for the `geometry` field — describes HOW the point was
  /// derived. Helps downstream consumers reason about precision:
  ///   - 'gps'                — authentic GPS coordinate (from a sensor or
  ///                            field officer's device)
  ///   - 'centroid'           — computed from a polygon's centroid (A0-A2)
  ///   - 'landmark-geocoded'  — resolved via the Nominatim geocoder from a
  ///                            landmark name extracted from signal text
  ///                            (e.g. "Nyala Airport")
  ///   - 'source-gps'         — coordinate as supplied by an alert source
  ///                            (Dataminr, ACLED, GDACS) when treated as
  ///                            precise GPS
  ///   - 'source-centroid'    — source coordinate detected as a district
  ///                            centroid (fake precision); event attributed
  ///                            to the containing admin unit
  /// Null for legacy rows created before this field existed.
  pointType String? @map("point_type")

  /// When the row was first inserted. Needed for debugging questions like
  /// "when did Al Kurmuk's geometry get backfilled?" — previously locations
  /// had no timestamps, making it impossible to correlate signal-ingestion
  /// timing against admin polygon availability.
  createdAt DateTime @default(now()) @map("created_at")
  /// Auto-updated by Prisma on every write. The DB-side DEFAULT NOW() is
  /// intentional: nine raw SQL INSERTs across src/utils/geo-resolve.ts,
  /// src/resolvers/location.resolver.ts, prisma/seed*.ts and the
  /// geo-resolve tests bypass the Prisma client and omit this column —
  /// keeping the default lets those continue to work without modification.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  parent   locations?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children locations[] @relation("LocationHierarchy")

  // alertLinks  alertLocations[]
  // sourceLinks sourceLocations[]

  // Reverse relations for signal
  signalOrigins      signals[] @relation("SignalOrigin")
  signalDestinations signals[] @relation("SignalDestination")
  signalLocations    signals[] @relation("SignalLocation")

  // Reverse relations for event
  eventOrigins           events[]                 @relation("EventOrigin")
  eventDestinations      events[]                 @relation("EventDestination")
  eventLocations         events[]                 @relation("EventLocation")
  userAlertSubscriptions userAlertSubscriptions[]
  teamScopes             teamLocations[]
  crises                 crises[]                 @relation("CrisisLocation")
  metadata               locationMetadata[]
  translations           translations[]

  @@index([level])
  @@index([parentId])
  @@index([ancestorIds(ops: ArrayOps)], type: Gin)
}

/// Arbitrary per-location metadata keyed by type (e.g. "iom_dtm_displacement",
/// "acaps_inform"). The `data` column is JSON so each source can store its
/// own shape.
///
/// History is preserved via the (validFrom, validTo) pair:
///   - validTo IS NULL  → the row is the CURRENT value for (location, type).
///   - validTo is set   → the row has been superseded (closed out) and is
///     part of the audit trail.
///
/// A natural partial-unique "one current row per (location, type)" is
/// enforced by the upsert resolver (close-old-then-insert-new inside a tx).
/// Enforcing it at the DB level would require a partial unique index which
/// Prisma doesn't model declaratively — the invariant is protected by code.
model locationMetadata {
  id         String    @id @default(cuid())
  locationId String    @map("location_id")
  location   locations @relation(fields: [locationId], references: [id], onDelete: Cascade)

  type String // e.g. "iom_dtm_displacement"
  data Json

  /// When this value became current. Defaults to row creation time.
  validFrom DateTime  @default(now()) @map("valid_from")
  /// When this value was superseded. Null means still current.
  validTo   DateTime? @map("valid_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locationId, type])
  @@index([locationId, type, validTo])
  @@index([type, validTo])
  @@map("location_metadata")
}

// ─── Data Mining ─────────────────────────────────────────────────────────────

model dataSources {
  id        String   @id @default(cuid())
  name      String
  type      String
  isActive  Boolean  @default(true) @map("is_active")
  baseUrl   String?  @map("url_base")
  infoUrl   String?  @map("url_info")

  /// Alias set for source-name normalisation. `resolveDataSource` matches an
  /// incoming name against `name` OR any `synonyms` entry (exact, then fuzzy)
  /// before creating a new row, so one organisation isn't recorded under many
  /// spellings ("IOM DTM" / "Displacement Tracking Matrix" / "DTM"). See ADR-0004.
  synonyms String[] @default([])

  /// NATO Admiralty-style source-reliability grade, 1 (least) – 4 (most).
  /// NULL = ungraded (new/unresolved source); the data-quality formula treats
  /// NULL as 1. Manually maintained by a domain expert. See ADR-0004 / ADR-0005.
  reliability Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  signals          signals[]
  reportDatapoints reportDatapoint[]

  @@index([type])
  @@index([isActive])
  @@map("data_sources")
}

/**
 * model source {
 * id         String          @id @default(cuid())
 * title      String
 * confidence Float?
 * status     DetectionStatus @default(raw)
 * detectedAt DateTime        @default(now()) @map("detected_at")
 * rawData    Json?           @map("raw_data")
 * dataSourceId String?     @map("data_source_id")
 * source       dataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
 * locations sourceLocation[]
 * signal    signal?          @relation("SignalDetection")
 * createdAt DateTime @default(now()) @map("created_at")
 * updatedAt DateTime @updatedAt @map("updated_at")
 * @@index([status, detectedAt])
 * @@index([dataSourceId, detectedAt])
 * }
 */

// ─── Core Product ────────────────────────────────────────────────────────────

model signals {
  id       String      @id @default(cuid())
  sourceId String      @map("source_id")
  source   dataSources @relation(fields: [sourceId], references: [id])

  /// Stable external identifier from the upstream source, e.g.
  ///   "dataminr:{alertId}", "gdacs:{eventid}", "acled:{event_id_cnty}".
  /// Nullable so pre-existing signals don't break the uniqueness check —
  /// Postgres treats multiple NULLs as distinct under a UNIQUE constraint.
  /// Any insert with a non-null externalId is deduped against existing rows.
  externalId String? @map("external_id")

  rawData     Json     @map("raw_data")
  publishedAt DateTime @map("published_at")
  collectedAt DateTime @default(now()) @map("collected_at")

  url         String?
  title       String?
  description String?
  severity    Int? // 1-5 scale; from data source or estimated by pipeline
  /// Reported fatalities/casualties for this signal. Sourced from ACLED's
  /// `fatalities` field directly, and parsed from raw text for Dataminr
  /// (regex: "X killed", "X dead", "X fatalities", etc.).
  casualties  Int?
  media       String[]
  isDummy     Boolean  @default(false)

  originId       String?    @map("origin_id")
  originLocation locations? @relation("SignalOrigin", fields: [originId], references: [id])

  destinationId       String?    @map("destination_id")
  destinationLocation locations? @relation("SignalDestination", fields: [destinationId], references: [id])

  locationId      String?    @map("location_id") // In case of signals without origin or destination
  generalLocation locations? @relation("SignalLocation", fields: [locationId], references: [id])

  /// Result of the text-based geoparser (clear-pipeline runs it at ingest).
  /// Additive enrichment for comparison against the source's coords —
  /// never used for routing or alert decisions in this phase.
  ///
  /// Shape (when present):
  ///   {
  ///     "candidate":     "Nyala Airport",
  ///     "kind":          "landmark" | "admin",
  ///     "field":         "title" | "body",
  ///     "lat":           12.0537,
  ///     "lng":           24.9543,
  ///     "country_code":  "sd",
  ///     "osm_class":     "aeroway",
  ///     "osm_type":      "aerodrome",
  ///     "importance":    0.55,
  ///     "display_name":  "Nyala Airport, South Darfur, Sudan"
  ///   }
  /// Null when the geoparser produced no usable result (no extractable
  /// candidates, Nominatim miss, or anything below the confidence floor).
  geoparsedData Json? @map("geoparsed_data")

  userFeedbacks userFeedbacks[]
  userComments  userComments[]
  signalEvents  signalEvents[]

  signalLocationChallenges signalLocationChallenges[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([publishedAt])
}

/// Analyst Location challenge on a Signal, with an optional Location correction
/// (Location trust v1, clear-mvp #314). A queue only — status is always
/// "consideration" in v1, there is no accept/reject flow, and it NEVER mutates
/// the Signal's own geometry. `@@unique([signalId, status])` keeps one open row
/// per Signal so a resubmit updates the existing challenge.
model signalLocationChallenges {
  id       String  @id @default(cuid())
  signalId String  @map("signal_id")
  signal   signals @relation(fields: [signalId], references: [id], onDelete: Cascade)

  /// Auth user id of whoever filed the challenge.
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// v1: always "consideration".
  status String @default("consideration")

  /// Optional note explaining why the pin looks wrong.
  note String?

  /// Optional Location correction — all three null = bare challenge. When a
  /// point is proposed, proposedLng + proposedLat are required together
  /// (enforced in the resolver + a DB CHECK added by the migration).
  proposedLng  Float?  @map("proposed_lng")
  proposedLat  Float?  @map("proposed_lat")
  proposedName String? @map("proposed_name")

  @@unique([signalId, status])
  @@index([signalId])
  @@index([status, createdAt])
  @@map("signal_location_challenges")
}

model events {
  id                  String  @id @default(cuid())
  title               String?
  description         String?
  // For LLM
  description_signals Json?

  validFrom            DateTime @default(now()) @map("valid_from")
  validTo              DateTime @map("valid_to")
  firstSignalCreatedAt DateTime @map("first_signal_created_at")
  lastSignalCreatedAt  DateTime @map("last_signal_created_at")
  isDummy              Boolean  @default(false)

  originId       String?    @map("origin_id")
  originLocation locations? @relation("EventOrigin", fields: [originId], references: [id])

  destinationId       String?    @map("destination_id")
  destinationLocation locations? @relation("EventDestination", fields: [destinationId], references: [id])

  locationId      String?    @map("location_id") // In case of events without origin or destination
  generalLocation locations? @relation("EventLocation", fields: [locationId], references: [id], onDelete: SetNull)

  types                 String[]
  severity              Int? // 1-5 scale; aggregated from signal severities
  populationAffected    BigInt?                 @map("population_affected")
  /// Population displaced by this event. Resolution order in the pipeline:
  /// (1) max across signal-level displacement data, (2) IOM DTM value cached
  /// in `locationMetadata(type="iom_dtm_displacement")` for the event's
  /// admin-2 location, (3) default fallback (1670).
  populationDisplaced   BigInt?                 @map("population_displaced")
  /// Aggregated casualties for this event (max across constituent signals).
  casualties            Int?
  rank                  Float
  alerts                alerts[]
  userFeedbacks         userFeedbacks[]
  userComments          userComments[]
  signalEvents          signalEvents[]
  eventEscaladedByUsers eventEscaladedByUsers[]
  eventCrises           eventCrises[]
  translations          translations[]
}

model disasterTypes {
  id            String @id @default(cuid())
  disasterType  String @map("disaster_type")
  disasterClass String @map("disaster_class")
  glideNumber   String @map("glide_number")

  /// Top-level category (e.g. "natural hazard", "conflict", "crisis").
  level1 String @default("") @map("level_1")
  /// Mid-level group (e.g. "protests", "battles", "flood").
  level2 String @default("") @map("level_2")
  /// Identifier system for glideNumber: "glide_number" or "clear_id".
  idType String @default("glide_number") @map("id_type")

  @@index([level1])
  @@index([level2])
  @@index([glideNumber])
  @@map("disaster_types")
}

model alerts {
  id      String      @id @default(cuid())
  eventId String      @map("event_id")
  status  AlertStatus

  /// When the alert row was first created. Needed for debugging "when did
  /// this fire?" — previously alerts had no timestamp and we could only date
  /// them by correlating to outbound email logs.
  createdAt DateTime @default(now()) @map("created_at")
  /// Updated automatically by Prisma on every write — useful for tracking
  /// status transitions (draft → published → archived).
  updatedAt DateTime @updatedAt @map("updated_at")

  event      events       @relation(fields: [eventId], references: [id])
  userAlerts userAlerts[]

  /// One alert per event. Status transitions (draft → published → archived)
  /// update this row in place; they do not create new ones.
  @@unique([eventId])
}

model crises {
  id          String   @id @default(cuid())
  title       String?
  summary     String?
  /// Forward-looking scenario analysis generated by the crisis enrichment
  /// task. Shape (when present):
  ///   {
  ///     "most_likely": "<paragraph describing the most probable trajectory>",
  ///     "best_case":   "<paragraph describing the best-case scenario>",
  ///     "worst_case":  "<paragraph describing the worst-case scenario>",
  ///     "description": "<paragraph summarising the scenario variables —
  ///                     political, economic, environmental, public-health,
  ///                     policy, access, response capacity, population
  ///                     movement — and which way each is trending>"
  ///   }
  /// Null until the enrichment task runs.
  scenarios   Json?
  /// S3 keys of user-uploaded supporting documents (reports, photos, PDFs).
  /// Stored as keys, not URLs — the GraphQL resolver converts each to a
  /// presigned URL at read time. Same pattern as `signals.media`.
  attachments String[] @default([])

  severity           Float
  locationId         String?    @map("location_id")
  generalLocation    locations? @relation("CrisisLocation", fields: [locationId], references: [id], onDelete: SetNull)
  needs              Json
  populationAffected BigInt?    @map("population_affected")
  populationInArea   BigInt?    @map("population_in_area")

  userFeedbacks userFeedbacks[]
  userComments  userComments[]
  eventCrises   eventCrises[]
  translations  translations[]

  createdAt DateTime @default(now()) @map("created_at")
  /// Kept in sync by Prisma on every `crises.update(...)` — matches the
  /// pattern used across the rest of this schema (translations, orgs,
  /// teams, feedbacks, etc). The migration's `DEFAULT CURRENT_TIMESTAMP`
  /// is a belt-and-braces for raw SQL writes that skip the ORM.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("crises")
}

