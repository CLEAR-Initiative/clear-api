generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AlertStatus {
  draft
  published
  archived

  @@map("alert_status")
}

enum DetectionStatus {
  raw
  processed
  ignored

  @@map("detection_status")
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  READ

  @@map("notification_status")
}

enum Channel {
  email
  sms
}

enum Frequency {
  immediately
  daily
  weekly
  monthly
}

// ─── Auth (Better Auth) ────────────────────────────────────────────────────

model user {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  phoneNumber   String? @map("phone_number")
  image         String?
  role          String  @default("viewer")
  isActive      Boolean @default(true) @map("is_active")

  inAppNotification Boolean @default(false) @map("in_app_notification")
  emailNotification Boolean @default(false) @map("email_notification")
  smsNotification   Boolean @default(false) @map("sms_notification")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  sessions session[]
  accounts account[]

  defaultTeamId String? @map("default_team_id")
  defaultTeam   teams?  @relation("DefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)

  alerts                userAlerts[]
  apiKeys               apiKeys[]
  notifications         notifications[]
  organisations         organisationUsers[]
  teamMemberships       teamMembers[]
  eventEscaladedByUsers eventEscaladedByUsers[]
  userFeedbacks         userFeedbacks[]
  userComments          userComments[]
  commentTags           commentTags[]
  invitationsSent       invitations[]           @relation("InvitedBy")
}

model session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")
}

// ––– Organisation ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––

model organisations {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       organisationUsers[]
  teams       teams[]
  invitations invitations[]
}

model organisationUsers {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organisationId String   @map("organisation_id")
  role           String   @default("member") // owner | admin | member
  createdAt      DateTime @default(now()) @map("created_at")

  user         user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation organisations @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@map("user_to_organisation")
}

// ––– Teams –––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––

model teams {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation     organisations     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members          teamMembers[]
  locations        teamLocations[]
  defaultForUsers  user[]            @relation("DefaultTeam")
  invitations      invitations[]
  invitationTeams  invitationTeams[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

model teamMembers {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   @default("viewer") // lead | analyst | viewer
  createdAt DateTime @default(now()) @map("created_at")

  team teams @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user user  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model teamLocations {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  team     teams     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  location locations @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([teamId, locationId])
  @@index([locationId])
  @@map("team_locations")
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model invitations {
  id             String    @id @default(cuid())
  email          String
  organisationId String    @map("organisation_id")
  /// Legacy single-team fields (kept for back-compat with rows created before
  /// `invitationTeams` existed). New invites use the join table — these stay
  /// null on multi-team invites.
  teamId         String?   @map("team_id")
  role           String    @default("member") // org role: owner | admin | member
  teamRole       String?   @map("team_role") // team role: lead | analyst | viewer
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  invitedById    String    @map("invited_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation organisations @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  team         teams?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy    user          @relation("InvitedBy", fields: [invitedById], references: [id])
  /// Multi-team assignments (each row is one (team, role) pair).
  teams        invitationTeams[]

  @@index([email])
  @@index([organisationId])
  @@map("invitations")
}

/// One row per (invitation, team) — lets a single invitation grant access to
/// multiple teams with different roles per team.
model invitationTeams {
  id           String @id @default(cuid())
  invitationId String @map("invitation_id")
  teamId       String @map("team_id")
  /// Team role: lead | analyst | viewer. Stored as a string to mirror
  /// teamMembers.role semantics; the GraphQL enum lives in the typedefs.
  teamRole     String @map("team_role")

  invitation invitations @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  team       teams       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([invitationId, teamId])
  @@index([teamId])
  @@map("invitation_teams")
}

// ─── Geography ───────────────────────────────────────────────────────────────

model locations {
  id          String                                  @id @default(cuid())
  geoId       Int?                                    @map("geonames_id")
  osmId       BigInt?                                 @map("osm_id")
  pCode       String?                                 @map("p_code") @db.VarChar(50)
  geometry    Unsupported("geometry(Geometry, 4326)") // use CHECK (GeometryType(geometry) IN ('POINT', 'MULTIPOLYGON'))
  name        String
  level       Int
  parentId    String?                                 @map("parent_id")
  ancestorIds String[]                                @map("ancestor_ids")
  /// Population residing within this location's geometry (from WorldPop raster).
  /// Populated by a background worker for admin levels 0-2. Null for point locations.
  population  BigInt?

  /// Provenance tag for the `geometry` field — describes HOW the point was
  /// derived. Helps downstream consumers reason about precision:
  ///   - 'gps'                — authentic GPS coordinate (from a sensor or
  ///                            field officer's device)
  ///   - 'centroid'           — computed from a polygon's centroid (A0-A2)
  ///   - 'landmark-geocoded'  — resolved via the Nominatim geocoder from a
  ///                            landmark name extracted from signal text
  ///                            (e.g. "Nyala Airport")
  ///   - 'source-gps'         — coordinate as supplied by an alert source
  ///                            (Dataminr, ACLED, GDACS) when treated as
  ///                            precise GPS
  ///   - 'source-centroid'    — source coordinate detected as a district
  ///                            centroid (fake precision); event attributed
  ///                            to the containing admin unit
  /// Null for legacy rows created before this field existed.
  pointType  String? @map("point_type")

  /// When the row was first inserted. Needed for debugging questions like
  /// "when did Al Kurmuk's geometry get backfilled?" — previously locations
  /// had no timestamps, making it impossible to correlate signal-ingestion
  /// timing against admin polygon availability.
  createdAt DateTime @default(now()) @map("created_at")
  /// Auto-updated by Prisma on every write. Useful for tracking when an
  /// admin polygon was (re-)loaded vs created.
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   locations?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children locations[] @relation("LocationHierarchy")

  // alertLinks  alertLocations[]
  // sourceLinks sourceLocations[]

  // Reverse relations for signal
  signalOrigins      signals[] @relation("SignalOrigin")
  signalDestinations signals[] @relation("SignalDestination")
  signalLocations    signals[] @relation("SignalLocation")

  // Reverse relations for event
  eventOrigins           events[]                 @relation("EventOrigin")
  eventDestinations      events[]                 @relation("EventDestination")
  eventLocations         events[]                 @relation("EventLocation")
  userAlertSubscriptions userAlertSubscriptions[]
  teamScopes             teamLocations[]
  crises                 crises[]                 @relation("CrisisLocation")
  metadata               locationMetadata[]

  @@index([level])
  @@index([parentId])
  @@index([ancestorIds(ops: ArrayOps)], type: Gin)
}

/// Arbitrary per-location metadata keyed by type (e.g. "iom_dtm_displacement",
/// "acaps_inform"). The `data` column is JSON so each source can store its
/// own shape.
///
/// History is preserved via the (validFrom, validTo) pair:
///   - validTo IS NULL  → the row is the CURRENT value for (location, type).
///   - validTo is set   → the row has been superseded (closed out) and is
///     part of the audit trail.
///
/// A natural partial-unique "one current row per (location, type)" is
/// enforced by the upsert resolver (close-old-then-insert-new inside a tx).
/// Enforcing it at the DB level would require a partial unique index which
/// Prisma doesn't model declaratively — the invariant is protected by code.
model locationMetadata {
  id         String    @id @default(cuid())
  locationId String    @map("location_id")
  location   locations @relation(fields: [locationId], references: [id], onDelete: Cascade)

  type String // e.g. "iom_dtm_displacement"
  data Json

  /// When this value became current. Defaults to row creation time.
  validFrom DateTime @default(now()) @map("valid_from")
  /// When this value was superseded. Null means still current.
  validTo DateTime? @map("valid_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([locationId, type])
  @@index([locationId, type, validTo])
  @@index([type, validTo])
  @@map("location_metadata")
}

// ─── Data Mining ─────────────────────────────────────────────────────────────

model dataSources {
  id        String   @id @default(cuid())
  name      String
  type      String
  isActive  Boolean  @default(true) @map("is_active")
  baseUrl   String?  @map("url_base")
  infoUrl   String?  @map("url_info")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  signals signals[]

  @@index([type])
  @@index([isActive])
  @@map("data_sources")
}

/**
 * model source {
 * id         String          @id @default(cuid())
 * title      String
 * confidence Float?
 * status     DetectionStatus @default(raw)
 * detectedAt DateTime        @default(now()) @map("detected_at")
 * rawData    Json?           @map("raw_data")
 * dataSourceId String?     @map("data_source_id")
 * source       dataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
 * locations sourceLocation[]
 * signal    signal?          @relation("SignalDetection")
 * createdAt DateTime @default(now()) @map("created_at")
 * updatedAt DateTime @updatedAt @map("updated_at")
 * @@index([status, detectedAt])
 * @@index([dataSourceId, detectedAt])
 * }
 */

// ─── Core Product ────────────────────────────────────────────────────────────

model signals {
  id       String      @id @default(cuid())
  sourceId String      @map("source_id")
  source   dataSources @relation(fields: [sourceId], references: [id])

  /// Stable external identifier from the upstream source, e.g.
  ///   "dataminr:{alertId}", "gdacs:{eventid}", "acled:{event_id_cnty}".
  /// Nullable so pre-existing signals don't break the uniqueness check —
  /// Postgres treats multiple NULLs as distinct under a UNIQUE constraint.
  /// Any insert with a non-null externalId is deduped against existing rows.
  externalId String? @map("external_id")

  rawData     Json     @map("raw_data")
  publishedAt DateTime @map("published_at")
  collectedAt DateTime @default(now()) @map("collected_at")

  url         String?
  title       String?
  description String?
  severity    Int? // 1-5 scale; from data source or estimated by pipeline
  /// Reported fatalities/casualties for this signal. Sourced from ACLED's
  /// `fatalities` field directly, and parsed from raw text for Dataminr
  /// (regex: "X killed", "X dead", "X fatalities", etc.).
  casualties  Int?
  media       String[]
  isDummy     Boolean  @default(false)

  originId       String?    @map("origin_id")
  originLocation locations? @relation("SignalOrigin", fields: [originId], references: [id])

  destinationId       String?    @map("destination_id")
  destinationLocation locations? @relation("SignalDestination", fields: [destinationId], references: [id])

  locationId      String?         @map("location_id") // In case of signals without origin or destination
  generalLocation locations?      @relation("SignalLocation", fields: [locationId], references: [id])

  /// Result of the text-based geoparser (clear-pipeline runs it at ingest).
  /// Additive enrichment for comparison against the source's coords —
  /// never used for routing or alert decisions in this phase.
  ///
  /// Shape (when present):
  ///   {
  ///     "candidate":     "Nyala Airport",
  ///     "kind":          "landmark" | "admin",
  ///     "field":         "title" | "body",
  ///     "lat":           12.0537,
  ///     "lng":           24.9543,
  ///     "country_code":  "sd",
  ///     "osm_class":     "aeroway",
  ///     "osm_type":      "aerodrome",
  ///     "importance":    0.55,
  ///     "display_name":  "Nyala Airport, South Darfur, Sudan"
  ///   }
  /// Null when the geoparser produced no usable result (no extractable
  /// candidates, Nominatim miss, or anything below the confidence floor).
  geoparsedData Json? @map("geoparsed_data")

  userFeedbacks   userFeedbacks[]
  userComments    userComments[]
  signalEvents    signalEvents[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([publishedAt])
}

model events {
  id                  String  @id @default(cuid())
  title               String?
  description         String?
  // For LLM
  description_signals Json?

  validFrom            DateTime @default(now()) @map("valid_from")
  validTo              DateTime @map("valid_to")
  firstSignalCreatedAt DateTime @map("first_signal_created_at")
  lastSignalCreatedAt  DateTime @map("last_signal_created_at")
  isDummy              Boolean  @default(false)

  originId       String?    @map("origin_id")
  originLocation locations? @relation("EventOrigin", fields: [originId], references: [id])

  destinationId       String?    @map("destination_id")
  destinationLocation locations? @relation("EventDestination", fields: [destinationId], references: [id])

  locationId      String?    @map("location_id") // In case of events without origin or destination
  generalLocation locations? @relation("EventLocation", fields: [locationId], references: [id], onDelete: SetNull)

  types                 String[]
  severity              Int? // 1-5 scale; aggregated from signal severities
  populationAffected    BigInt?                 @map("population_affected")
  /// Population displaced by this event. Resolution order in the pipeline:
  /// (1) max across signal-level displacement data, (2) IOM DTM value cached
  /// in `locationMetadata(type="iom_dtm_displacement")` for the event's
  /// admin-2 location, (3) default fallback (1670).
  populationDisplaced   BigInt?                 @map("population_displaced")
  /// Aggregated casualties for this event (max across constituent signals).
  casualties            Int?
  rank                  Float
  alerts                alerts[]
  userFeedbacks         userFeedbacks[]
  userComments          userComments[]
  signalEvents          signalEvents[]
  eventEscaladedByUsers eventEscaladedByUsers[]
  eventCrises           eventCrises[]
}

model disasterTypes {
  id            String @id @default(cuid())
  disasterType  String @map("disaster_type")
  disasterClass String @map("disaster_class")
  glideNumber   String @map("glide_number")

  /// Top-level category (e.g. "natural hazard", "conflict", "crisis").
  level1 String @default("") @map("level_1")
  /// Mid-level group (e.g. "protests", "battles", "flood").
  level2 String @default("") @map("level_2")
  /// Identifier system for glideNumber: "glide_number" or "clear_id".
  idType String @default("glide_number") @map("id_type")

  @@index([level1])
  @@index([level2])
  @@index([glideNumber])
  @@map("disaster_types")
}

model alerts {
  id      String      @id @default(cuid())
  eventId String      @map("event_id")
  status  AlertStatus

  /// When the alert row was first created. Needed for debugging "when did
  /// this fire?" — previously alerts had no timestamp and we could only date
  /// them by correlating to outbound email logs.
  createdAt DateTime @default(now()) @map("created_at")
  /// Updated automatically by Prisma on every write — useful for tracking
  /// status transitions (draft → published → archived).
  updatedAt DateTime @updatedAt @map("updated_at")

  event      events       @relation(fields: [eventId], references: [id])
  userAlerts userAlerts[]

  /// One alert per event. Status transitions (draft → published → archived)
  /// update this row in place; they do not create new ones.
  @@unique([eventId])
}

model crises {
  id      String  @id @default(cuid())
  title   String?
  summary String?

  severity           Float
  locationId         String?    @map("location_id")
  generalLocation    locations? @relation("CrisisLocation", fields: [locationId], references: [id], onDelete: SetNull)
  needs              Json
  populationAffected BigInt?    @map("population_affected")
  populationInArea   BigInt?    @map("population_in_area")

  userFeedbacks userFeedbacks[]
  userComments  userComments[]
  eventCrises   eventCrises[]

  @@map("crises")
}

// ─── Join Tables ─────────────────────────────────────────────────────────────

/**
 * model alertLocations {
 * id         String   @id @default(cuid())
 * alertId    String   @map("alert_id")
 * locationId String   @map("location_id")
 * createdAt  DateTime @default(now()) @map("created_at")
 * updatedAt  DateTime @default(now()) @map("updated_at")
 * alert    alerts    @relation(fields: [alertId], references: [id], onDelete: Cascade)
 * location locations @relation(fields: [locationId], references: [id], onDelete: Cascade)
 * @@unique([alertId, locationId])
 * @@index([locationId])
 * @@map("alert_locations")
 * }
 * model sourceLocations {
 * id         String   @id @default(cuid())
 * sourceId   String   @map("source_id")
 * locationId String   @map("location_id")
 * createdAt  DateTime @default(now()) @map("created_at")
 * source   dataSources   @relation(fields: [sourceId], references: [id])
 * location locations @relation(fields: [locationId], references: [id])
 * @@unique([sourceId, locationId])
 * @@index([locationId])
 * @@map("source_locations")
 * }
 */

// Map alerts received by users
model userAlerts {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  alertId  String    @map("alert_id")
  viewedAt DateTime? @map("viewed_at")

  user  user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert alerts @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([userId, alertId])
  @@index([alertId])
  @@index([userId, viewedAt])
  @@map("user_alerts")
}

// Map the events escaladed by users as alerts which can be further escaladed as crisis
model eventEscaladedByUsers {
  id       String  @id @default(cuid())
  userId   String  @map("user_id")
  eventId  String  @map("event_id")
  isCrisis Boolean @default(false) @map("is_crisis")

  validFrom DateTime @default(now()) @map("valid_from")
  validTo   DateTime @map("valid_to")

  user  user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event events @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_escaladed_by_users")
}

model userFeedbacks {
  id     String @id @default(cuid())
  userId String @map("user_id")

  eventId  String? @map("event_id")
  signalId String? @map("signal_id")
  crisisId String? @map("crisis_id")
  rating   Int
  // Textual feedback
  text     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal signals? @relation(fields: [signalId], references: [id], onDelete: Cascade)
  event  events?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  crisis crises?  @relation(fields: [crisisId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_feedbacks")
}

model userComments {
  id     String @id @default(cuid())
  userId String @map("user_id")

  eventId  String? @map("event_id")
  signalId String? @map("signal_id")
  crisisId String? @map("crisis_id")

  comment            String  @map("text")
  isCommentReply     Boolean @map("is_comment_reply")
  repliedToCommentId String? @map("replied_to_comment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal signals? @relation(fields: [signalId], references: [id], onDelete: Cascade)
  event  events?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  crisis crises?  @relation(fields: [crisisId], references: [id], onDelete: Cascade)

  commentTags commentTags[]

  @@index([userId])
  @@index([eventId])
  @@index([signalId])
  @@map("user_comments")
}

model commentTags {
  userId    String @map("user_id")
  commentId String @map("comment_id")

  user    user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment userComments @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_tags")
}

model userAlertSubscriptions {
  id     String @id @default(cuid())
  userId String @map("user_id")

  locationId String    @map("location_id")
  location   locations @relation(fields: [locationId], references: [id])

  alertType String  @map("event_type")
  active    Boolean @default(true)

  /// Minimum event severity (1-5) for notification — only alerts with
  /// event.severity >= minSeverity trigger notifications for this subscription.
  minSeverity Int @default(1) @map("min_severity")

  channel   Channel
  frequency Frequency

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_alert_subscriptions")
}

model signalEvents {
  id          String   @id @default(cuid())
  signalId    String   @map("signal_id")
  eventId     String   @map("event_id")
  collectedAt DateTime @map("collected_at")

  signal signals @relation(fields: [signalId], references: [id], onDelete: Cascade)
  event  events  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// A signal can only be linked to a given event once.
  @@unique([signalId, eventId])
  @@map("signal_to_events")
}

model eventCrises {
  id          String   @id @default(cuid())
  crisisId    String   @map("crisis_id")
  eventId     String   @map("event_id")
  collectedAt DateTime @map("collected_at")

  crisis crises @relation(fields: [crisisId], references: [id], onDelete: Cascade)
  event  events @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_to_crises")
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model apiKeys {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  keyHash    String    @unique @map("key_hash")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
  @@map("api_keys")
}

// ─── Feature Flags ───────────────────────────────────────────────────────────

model featureFlags {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ─── Notifications ———————————————————————————————————————————————————————————

model notifications {
  id               String @id @default(cuid())
  userId           String @map("user_id")
  message          String
  notificationType String @map("notification_type")

  actionUrl  String? @map("action_url")
  actionText String? @map("action_text")

  status                  NotificationStatus  @default(PENDING)
  emailNotificationStatus NotificationStatus? @map("email_notification_status")
  smsNotificationStatus   NotificationStatus? @map("sms_notification_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Nominatim geocoder cache ————————————————————————————————————————————————

/// Persistent cache of Nominatim-protocol geocoder responses. The
/// clear-pipeline geoparser checks this table before issuing any outbound
/// API call; only cache misses hit the geocoder. Negative results
/// (no_result, error) are cached too so we don't re-ask the same dead
/// question.
///
/// Named for the protocol (Nominatim), not the current vendor (LocationIQ).
/// Any Nominatim-compatible backend — LocationIQ, MapTiler's Nominatim,
/// self-hosted Nominatim — produces the same response shape and uses this
/// same cache transparently.
///
/// Lookup is by `queryHash` = SHA-256 of `<endpoint>:<normalised_query>`.
/// Storing the raw `query` is for debugging and audit; resolution uses
/// the hash for stability against whitespace / casing drift.
///
/// `expiresAt` is set to fetchedAt + 6 months by the writer. Reads should
/// filter on `expiresAt > NOW()` so stale rows don't poison lookups. A
/// periodic cleanup job (out of scope here) can DELETE WHERE expires_at <
/// NOW() - INTERVAL '1 month' to reclaim space.
model nominatim_cache {
  id           String   @id @default(cuid())
  /// SHA-256 hex digest of `<endpoint>:<normalised_query>`. Used as the
  /// stable lookup key — insensitive to whitespace/casing variations as
  /// long as the caller normalises before hashing.
  queryHash    String   @unique @map("query_hash")
  /// Raw query string for debugging only. Don't rely on it for lookups.
  query        String
  /// Nominatim endpoint that produced this response — typically 'search'
  /// or 'reverse'. Lets us cache different lookups for the same query text.
  endpoint     String
  /// Raw Nominatim JSON response, stored as-is so we can change downstream
  /// parsing rules without re-querying.
  responseJson Json     @map("response_json")
  /// 'ok'         — usable result returned
  /// 'no_result'  — the geocoder returned an empty result set
  /// 'error'      — the geocoder returned an error response (cached briefly
  ///                so we don't hammer them while they're degraded)
  status       String

  fetchedAt DateTime @default(now()) @map("fetched_at")
  expiresAt DateTime                 @map("expires_at")

  @@index([queryHash])
  @@index([expiresAt])
  @@map("nominatim_cache")
}
