// ─── Nominatim geocoder cache ————————————————————————————————————————————————

/// Persistent cache of Nominatim-protocol geocoder responses. The
/// clear-pipeline geoparser checks this table before issuing any outbound
/// API call; only cache misses hit the geocoder. Negative results
/// (no_result, error) are cached too so we don't re-ask the same dead
/// question.
///
/// Named for the protocol (Nominatim), not the current vendor (LocationIQ).
/// Any Nominatim-compatible backend — LocationIQ, MapTiler's Nominatim,
/// self-hosted Nominatim — produces the same response shape and uses this
/// same cache transparently.
///
/// Lookup is by `queryHash` = SHA-256 of `<endpoint>:<normalised_query>`.
/// Storing the raw `query` is for debugging and audit; resolution uses
/// the hash for stability against whitespace / casing drift.
///
/// `expiresAt` is set to fetchedAt + 6 months by the writer. Reads should
/// filter on `expiresAt > NOW()` so stale rows don't poison lookups. A
/// periodic cleanup job (out of scope here) can DELETE WHERE expires_at <
/// NOW() - INTERVAL '1 month' to reclaim space.
model nominatim_cache {
  id           String @id @default(cuid())
  /// SHA-256 hex digest of `<endpoint>:<normalised_query>`. Used as the
  /// stable lookup key — insensitive to whitespace/casing variations as
  /// long as the caller normalises before hashing.
  queryHash    String @unique @map("query_hash")
  /// Raw query string for debugging only. Don't rely on it for lookups.
  query        String
  /// Nominatim endpoint that produced this response — typically 'search'
  /// or 'reverse'. Lets us cache different lookups for the same query text.
  endpoint     String
  /// Raw Nominatim JSON response, stored as-is so we can change downstream
  /// parsing rules without re-querying.
  responseJson Json   @map("response_json")
  /// 'ok'         — usable result returned
  /// 'no_result'  — the geocoder returned an empty result set
  /// 'error'      — the geocoder returned an error response (cached briefly
  ///                so we don't hammer them while they're degraded)
  status       String

  fetchedAt DateTime @default(now()) @map("fetched_at")
  expiresAt DateTime @map("expires_at")

  @@index([queryHash])
  @@index([expiresAt])
  @@map("nominatim_cache")
}

/// Chunk-level knowledge base built from ReliefWeb PDFs (and, later, other
/// long-form sources). Each row is a single ~800-token excerpt from a
/// source document, embedded and indexed for hybrid (vector + BM25)
/// retrieval and pre-filtered by the parameters an LLM extracted from
/// the chunk (locations, time range, event types, need sectors).
///
/// Provider-agnostic by design: `embeddingProvider` + `embeddingModel`
/// let us swap between voyage-3-large / bge-m3 / future models without
/// re-embedding everything at once — search API filters to rows written
/// by the currently-configured model, and a backfill can top up any
/// missing coverage.
///
/// Writes/reads go through raw SQL only (`$queryRaw` / `$executeRaw`)
/// because `embedding` and `lexicalTsv` are `Unsupported` — the Prisma
/// client can't serialise them. Downstream code must reflect that.
model knowledgebase {
  id            String @id @default(cuid())

  /// Report identifier the chunk came from.
  reportId      String @map("report_id")
  reportTitle   String @map("report_title")
  sourceUrl     String @map("source_url")
  /// S3 key of the PDF this chunk was extracted from — lets a search
  /// hit link back to the original document without re-fetching from
  /// ReliefWeb.
  s3Key      String @map("s3_key")
  publishedAt   DateTime @map("published_at")

  /// Position of the chunk within its report (0-indexed).
  chunkIndex    Int    @map("chunk_index")
  /// Inclusive PDF page range this chunk covers. Kept as start/end
  /// rather than a single page so chunks that straddle a page break
  /// still cite correctly.
  pageStart     Int    @map("page_start")
  pageEnd       Int    @map("page_end")

  /// Original excerpt text — what a UI would render on a search hit.
  chunkText     String @map("chunk_text")
  /// LLM-generated 50–100 token context prefix that situates the chunk
  /// within the report (Anthropic's "Contextual Retrieval" technique).
  /// Kept separate so we can regenerate it independently of the excerpt.
  contextPrefix String @map("context_prefix")
  /// `contextPrefix + "\n\n" + chunkText` — what actually got embedded
  /// and tokenised into `lexical_tsv`. Stored verbatim so we can
  /// reproduce the ranking behaviour offline.
  embeddedText  String @map("embedded_text")

  /// Which provider produced `embedding`. Search API filters by this so
  /// mixed-model rows never contaminate a nearest-neighbour query.
  embeddingProvider String @map("embedding_provider")
  /// Specific model version — pinned so a silent provider-side model
  /// upgrade shows up here as a mismatch instead of degrading recall.
  embeddingModel    String @map("embedding_model")

  /// 1024-dim dense embedding (cosine-normalised). Written and read
  /// exclusively via raw SQL. Backed by an HNSW index for k-NN — the
  /// index itself lives in the migration SQL because Prisma can't
  /// express HNSW natively. Keep this field intact; removing it would
  /// force Prisma to DROP the column (and cascade the HNSW index).
  embedding Unsupported("vector(1024)")

  /// BM25/lexical column, populated by a BEFORE INSERT/UPDATE trigger
  /// from `embedded_text`. GIN index added in the migration. Same
  /// preservation rule as `embedding` — don't remove this field from
  /// the model without also updating the search path.
  lexicalTsv Unsupported("tsvector") @map("lexical_tsv")

  /// Location IDs resolved back to `locations.id` when the extracted
  /// pcode/name matched a CLEAR row. Empty when the LLM produced a
  /// location the resolver couldn't tie to an admin unit.
  locationIds    String[] @map("location_ids")
  /// Raw pcodes the LLM emitted — kept alongside `locationIds` so a
  /// future backfill of `locations` can re-resolve without re-running
  /// the extraction step.
  locationPcodes String[] @map("location_pcodes")

  /// Optional event window the chunk describes. When absent, the chunk
  /// is treated as reference / evergreen material.
  timeRangeStart DateTime? @map("time_range_start")
  timeRangeEnd   DateTime? @map("time_range_end")

  /// GLIDE codes (or the CLEAR internal disaster-type slug) the chunk
  /// pertains to. Multi-hazard sitreps are the norm — arrays, not scalars.
  eventTypes  String[] @map("event_types")
  /// NRC SAF sectors the chunk discusses: Shelter, WASH, Protection,
  /// Health, Food Security, Education. Constrained to the enum by the
  /// extraction prompt so filter queries don't have to normalise.
  needSectors String[] @map("need_sectors")

  createdAt DateTime @default(now()) @map("created_at")

  /// A given (report, chunk_index) pair is unique per re-ingest — the
  /// upsert path deletes-then-inserts per report so this doubles as the
  /// idempotency key.
  @@unique([reportId, chunkIndex])
  @@index([reportId])
  @@index([embeddingModel])
  @@index([locationIds], type: Gin)
  @@index([eventTypes], type: Gin)
  @@index([needSectors], type: Gin)
  @@index([timeRangeStart, timeRangeEnd])
  @@map("knowledgebase")
}

/// Outbound webhook subscription. Configured by platform admins; every
/// incoming GlitchTip alert is fanned out to every active subscription
/// whose filters match. HMAC signing is opt-out (not currently exposed —
/// every delivery is signed with the row's `secret`).
model WebhookSubscription {
  id        String @id @default(uuid())
  /// Human-readable label shown in the admin UI. Not sent downstream.
  name      String
  /// Target URL. Must include scheme; https is enforced at write time.
  targetUrl String @map("target_url")
  /// HMAC-SHA256 key. Generated on create (32 random bytes, hex-encoded),
  /// rotatable via a dedicated mutation. Stored plaintext because the
  /// signing worker needs it; scope of exposure is limited to platform
  /// admins who created it and can already read it.
  secret    String

  /// Pause without deleting. `false` skips this subscription during fan-out.
  active Boolean @default(true)

  /// Optional event-type allowlist. Empty array (default) = all types.
  /// GlitchTip's alert payload carries an "event_type" field like
  /// "issue.new", "issue.regression", "issue.resolved" — we match on that.
  eventTypeFilter String[] @default([]) @map("event_type_filter")

  /// User who created this subscription. Kept for audit; not FK-linked
  /// because the audit trail should survive user deletion.
  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([active])
  @@map("webhook_subscriptions")
}

/// One row per (subscription, incoming-event) delivery attempt-sequence.
/// A single row tracks the whole retry chain — `attemptNumber` and
/// `nextRetryAt` are advanced in-place. `succeededAt` non-null marks the
/// chain complete; `attemptNumber >= 5 && succeededAt == null` marks it
/// DLQ.
model WebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// GlitchTip's event ID (present in the payload). Kept for admin
  /// debugging / correlating back to the source issue.
  eventId String @map("event_id")

  /// Event type extracted from the payload (e.g. "issue.new"). Cached on
  /// the row so the delivery-history UI doesn't need to re-parse the body.
  eventType String @map("event_type")

  /// 1-indexed. 1 = first attempt; 2..5 = retries; 6 would be DLQ (never
  /// written because we mark and stop at 5 failed attempts).
  attemptNumber Int @default(1) @map("attempt_number")

  /// The exact JSON POSTed to the target URL. Preserved for replay/debug.
  /// Includes the GlitchTip payload verbatim.
  requestBody Json @map("request_body")

  /// Populated on each attempt. Null while pending. On failure, contains
  /// whatever the target returned (or the network error message).
  responseStatus Int?    @map("response_status")
  responseBody   String? @map("response_body")
  error          String?

  /// Non-null once the target returned 2xx. Terminal state.
  succeededAt DateTime? @map("succeeded_at")

  /// When the retry poller should pick this up. Null after success (no
  /// more attempts). On failure, computed as now() + exponential backoff.
  nextRetryAt DateTime? @map("next_retry_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([subscriptionId, createdAt])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

/// Structured, per-report humanitarian datapoints extracted from a
/// source document (typically a ReliefWeb sitrep). One row per report.
/// Powers the Layer 2 read path in the situation-analysis dashboard
/// and feeds the aggregation pipeline that produces
/// `aggregated_datapoints`.
///
/// Design decisions (see docs/humanitarian-datapoint-extraction.md):
///   - JSONB `data` blob carries the exhaustive extracted payload
///     across the 6 domain sub-schemas (timing_and_scope, casualties,
///     displacement, needs_and_funding, access_and_incidents,
///     narrative_and_confidence). Per-field shape is
///     { value, unit, confidence, source_quote, chunk_index, page_number }.
///   - Denormalised "hot" scalars (total_affected / total_displaced /
///     total_killed) mirror the sum-over-unspecified-event bucket for
///     each so the dashboard can filter and sort without opening the
///     JSON blob.
///   - `schema_version` is the load-bearing versioning field:
///     aggregation only combines rows with matching version. A prompt
///     or taxonomy change bumps the version and triggers targeted
///     re-extraction of recent reports before Layer 1 flips over.
///
/// Writes go through raw SQL only for `data` (Prisma serialises Json
/// safely, but multi-row upserts benefit from the same batching we use
/// on knowledgebase). Reads go through Prisma's typed client.
model reportDatapoint {
  id      String @id @default(cuid())

  /// Stable dedup key for the report. Matches `knowledgebase.report_id`
  /// when the same source PDF is also embedded for vector RAG — a
  /// downstream consumer can join the two tables to correlate
  /// structured data with the narrative chunks it was extracted from.
  reportId    String @unique @map("report_id")
  reportTitle String @map("report_title")
  sourceUrl   String @map("source_url")

  /// The report's PUBLISHER source (ReliefWeb `report.source`, primary else
  /// first), resolved to a `data_sources` row via `resolveDataSource`. This is
  /// the fallback source for any figure that doesn't cite its own origin — a
  /// figure's cited source lives per-`NumericField` inside `data`. Nullable
  /// until the source-attribution re-extraction backfills existing rows. ADR-0004.
  sourceId String?      @map("source_id")
  source   dataSources? @relation(fields: [sourceId], references: [id])

  /// When the source document was issued. Not the reporting period —
  /// see below.
  publishedAt DateTime @map("published_at")

  /// The window the CONTENT describes. Sitreps typically report on a
  /// 2–6 week trailing period; conflating this with `publishedAt`
  /// pollutes weekly aggregation buckets. Left nullable because a
  /// minority of reports don't state a period explicitly — the
  /// extractor infers a fallback and flags it as `estimated`.
  reportingPeriodStart DateTime? @map("reporting_period_start")
  reportingPeriodEnd   DateTime? @map("reporting_period_end")

  /// Locations mentioned by the report, resolved to `locations.id`
  /// where a match was found. `location_pcodes` preserves raw pcodes
  /// the resolver couldn't tie back — a nightly backfill re-attempts
  /// resolution as the `locations` tree grows.
  locationIds    String[] @map("location_ids")
  locationPcodes String[] @map("location_pcodes")

  /// Free-text event categories the report covers (mapped later to
  /// `disaster_types` glide codes during aggregation). Array because
  /// multi-hazard sitreps are the norm.
  eventTypes String[] @map("event_types")

  /// Denormalised "hot" totals for cheap filter / sort on the
  /// dashboard. Populated from the corresponding `unspecified`-bucket
  /// entries in `data.casualties` / `data.displacement`; NULL when
  /// the report doesn't report a top-line figure. Do NOT sum these
  /// across rows — the JSON blob carries the disaggregated form
  /// that respects incident-level dedup.
  totalAffected  Int? @map("total_affected")
  totalDisplaced Int? @map("total_displaced")
  totalKilled    Int? @map("total_killed")

  /// Exhaustive extracted payload keyed by sub-schema name. Every
  /// numeric leaf is a NumericField object carrying provenance —
  /// see the shared Pydantic schema in
  /// `clear-context-pipeline/src/clear_context_pipeline/defs/knowledgebase/datapoints_schemas.py`.
  data Json

  /// Schema-version string like "v1". Aggregation only combines
  /// same-version rows; version bumps drive targeted re-extraction.
  schemaVersion String @map("schema_version")

  /// Provenance for the extraction itself — which LLM + which
  /// pipeline run produced this row. Feeds the reviewer-audit
  /// workflow (§13 of the design doc).
  extractedByModel String   @map("extracted_by_model")
  extractedAt      DateTime @default(now()) @map("extracted_at")

  @@index([reportingPeriodStart, reportingPeriodEnd])
  @@index([locationIds], type: Gin)
  @@index([eventTypes], type: Gin)
  @@index([schemaVersion])
  @@index([sourceId])
  @@map("report_datapoints")
}

/// Pre-computed roll-ups of `report_datapoints` grouped by
/// (window × window_kind × location) at the four tiers the design
/// doc pins:
///
///   weekly × A2 (atomic — never rebuilt from anything else)
///   monthly × A1
///   yearly × country
///   all-time × country
///
/// The atomic tier is the source of truth: higher tiers can always be
/// recomputed from weekly × A2 aggregations. Any read window that
/// doesn't match one of the four tiers is served by on-demand rollup
/// in the resolver, using the same aggregation function the pre-
/// compute path runs (§6.6 of the design doc).
///
/// Every field in `data` carries a quality envelope alongside its
/// value — `{ value, quality_score, confidence_mix, newest_report_at,
/// oldest_report_at, contributing_report_ids }` — so the dashboard
/// can render freshness / trust affordances without a second query.
model aggregatedDatapoint {
  id String @id @default(cuid())

  /// The window this aggregation covers. Half-open on the design doc's
  /// convention but stored inclusive here for query ergonomics —
  /// resolvers convert as needed.
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")

  /// One of "weekly" | "monthly" | "yearly" | "all". Kept as text
  /// rather than an enum so a future tier addition doesn't require
  /// a migration.
  windowKind String @map("window_kind")

  /// Location this bucket rolls up to. NULL means country-wide (used
  /// by the yearly and all-time tiers). Otherwise references
  /// `locations.id`.
  locationId String? @map("location_id")

  /// Aggregated payload — same key structure as `report_datapoints.data`
  /// but every numeric leaf is a QualityEnvelope object
  /// (value + quality_score + confidence_mix + provenance).
  data Json

  /// Report ids that contributed to this bucket. Denormalised out of
  /// `data` so the dashboard can list sources cheaply.
  contributingReportIds String[] @map("contributing_report_ids")

  /// Bucket-level freshness / quality metadata surfaced as columns so
  /// the dashboard can filter and sort without opening the JSON blob.
  newestSourceAt   DateTime @map("newest_source_at")
  oldestSourceAt   DateTime @map("oldest_source_at")
  dataQualityScore Float    @map("data_quality_score")
  reportCount      Int      @map("report_count")

  /// Bitemporal validity.
  ///
  ///   validFrom: when this snapshot was computed and became current.
  ///   validTo:   when it was superseded by a fresher computation.
  ///              NULL means "still current".
  ///
  /// The resolver's default cache lookup is `WHERE valid_to IS NULL`;
  /// callers who want a historical snapshot pass an `asOf` date and
  /// the resolver filters `WHERE valid_from <= asOf AND
  /// (valid_to IS NULL OR valid_to > asOf)`.
  ///
  /// When new `report_datapoints` arrive, the mutation stamps
  /// `validTo = now()` on affected buckets (marking them superseded
  /// without deletion), and the next Dagster aggregation run inserts
  /// fresh rows with `validFrom = now()`. Between the two, queries
  /// for those buckets fall through to on-demand aggregation over
  /// `report_datapoints` directly.
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")

  /// Matches `report_datapoints.schema_version`. Rows are recomputed
  /// per version so version bumps don't mix incompatible payloads.
  schemaVersion String   @map("schema_version")
  computedAt    DateTime @default(now()) @map("computed_at")

  /// The natural key for cache lookup — at most ONE current row per
  /// (window, kind, location, version) combination. History rows
  /// (validTo NOT NULL) don't participate in this constraint; the
  /// partial unique index that enforces it lives in the migration
  /// SQL because Prisma can't express partial indexes in the DSL.
  @@index([locationId, windowStart])
  @@index([validTo])
  @@index([windowKind, windowStart, locationId, schemaVersion])
  @@map("aggregated_datapoints")
}

/// Pre-computed situation-analysis snapshot per (country × year).
/// Consumed by the situation-analysis dashboard as a single-row read;
/// regenerated weekly by the Dagster `weekly_situation_analyses` asset
/// downstream of the aggregation refresh.
///
/// The `data` blob carries seven top-level components — see the
/// situation-analysis design in
/// `clear-context-pipeline/docs/humanitarian-datapoint-extraction.md`
/// (extension pending) and the Pydantic schemas in
/// `clear-context-pipeline/src/clear_context_pipeline/defs/situation/schemas.py`:
///
///   1. datapoints                     (deterministic — hoisted from aggregated_datapoints)
///   2. ai_summary                     (LLM — narrative prose)
///   3. context_risks                  (LLM — 8 sub-domains × bullets)
///   4. hazards_and_vulnerabilities    (LLM — bullets)
///   5. displacement                   (LLM — push_factors + return_intention)
///   6. sectors                        (LLM — 6 SAF sectors × severity + top_needs + interventions + info_coverage)
///   7. sources                        (deterministic — union of contributing_report_ids joined with report titles)
///
/// Every LLM-generated section carries its own `source_report_ids`
/// so the sources tab renders from a single JSON walk without a
/// second query. The top-level `sourceReportIds` column is the
/// denormalised union for cheap admin-side filtering.
model situationAnalysis {
  id                     String   @id @default(cuid())

  /// FK to `locations.id` — the country (A0) this analysis covers.
  /// Not enforced as a Prisma relation because the situation-analysis
  /// pipeline should keep working even when locations are pruned /
  /// reshuffled during backfills.
  countryLocationId      String   @map("country_location_id")

  /// Analysis window — currently Jan 1..Dec 31 of the target year,
  /// but stored as a general range so a future switch to rolling-12-
  /// month windows doesn't need a schema migration.
  ///
  /// Reads key on (countryLocationId, windowKind, windowStart) and never
  /// on windowEnd. windowEnd is a derived detail: the pipeline and the
  /// resolver each build the calendar window independently, and matching
  /// it on exact equality meant the writer's 23:59:59.000 never met the
  /// reader's 23:59:59.999. windowStart is unambiguous.
  windowStart            DateTime @map("window_start")
  windowEnd              DateTime @map("window_end")

  /// "yearly" today. Mirrors `aggregatedDatapoint.windowKind` so a
  /// monthly or weekly analysis needs no migration, and so the bucket
  /// key states its granularity instead of implying it from two dates.
  windowKind             String   @map("window_kind")

  /// The full analysis payload keyed by component name. See docstring
  /// above and the Python schemas for shape.
  data                   Json

  /// Denormalised union of every contributing report id across all
  /// components. Enables cheap "which reports fed this analysis" +
  /// bulk admin queries without opening the JSON blob.
  sourceReportIds        String[] @map("source_report_ids")

  /// FK-ish reference to the `aggregated_datapoints.id` this analysis
  /// was generated against. Optional because early runs may fire
  /// before aggregations exist for the country-year. Kept as a plain
  /// text column (no @relation) so aggregation-side cleanups don't
  /// cascade-delete analyses.
  aggregatedDatapointId  String?  @map("aggregated_datapoint_id")

  /// LLM identifier (e.g. `claude-sonnet-4-6`). Deterministic-only
  /// runs (Phase B) record a synthetic value like `deterministic:v1`.
  generatedByModel       String   @map("generated_by_model")
  /// Total LLM cost across all component calls, if the caller tracks it.
  /// Null for deterministic-only runs.
  generationCostUsd      Float?   @map("generation_cost_usd")
  generatedAt            DateTime @default(now()) @map("generated_at")

  /// Bitemporal validity — same pattern as aggregated_datapoints.
  /// Every weekly regeneration inserts a new row and stamps the
  /// previous "current" row's validTo. History is preserved for the
  /// "compare to last week" dashboard UX and for audit.
  validFrom              DateTime @default(now()) @map("valid_from")
  validTo                DateTime? @map("valid_to")

  /// Bumped when either the output taxonomy OR the prompt set
  /// changes. Rows of different schema versions never mix on trend
  /// views; a version bump triggers full regeneration.
  schemaVersion          String   @map("schema_version")

  /// Partial unique index in the migration SQL:
  ///   UNIQUE (country_location_id, window_start, window_end, schema_version)
  ///   WHERE valid_to IS NULL NULLS NOT DISTINCT
  /// History rows (validTo NOT NULL) don't participate.
  /// Read path filters on (countryLocationId, windowKind, windowStart) —
  /// never on windowEnd. `map:` is explicit because Prisma's derived name
  /// for these three columns exceeds Postgres's 63-char identifier limit
  /// and would be silently truncated into something that doesn't match
  /// the hand-authored migration.
  @@index([countryLocationId, windowKind, windowStart], map: "situation_analyses_country_window_kind_window_start_idx")
  @@index([validTo])
  @@index([schemaVersion])
  @@map("situation_analyses")
}

/// GeoNames gazetteer places, one row per geonameid, seeded per-country
/// from the extracts in `src/geonames/` via `scripts/import-geonames.ts`.
/// Runtime source of truth for the offline first tier of the hybrid
/// geo-resolver (see `resolveGazetteerLocation`); the raw .txt dumps are
/// gitignored.
model geonames {
  geonamesId   Int     @id @map("geonames_id")
  name         String
  asciiName    String? @map("ascii_name")
  latitude     Float
  longitude    Float
  /// GeoNames feature class: A=admin area, P=populated place, H=hydro,
  /// L=area, S=spot/POI, T=terrain, … Used to prefer real settlements.
  featureClass String? @map("feature_class")
  featureCode  String? @map("feature_code")
  /// ISO-3166-1 alpha-2 (SD, VE, AF).
  countryCode  String  @map("country_code")
  admin1Code   String? @map("admin1_code")
  population   BigInt  @default(0)

  names        geonamesName[]

  @@index([countryCode])
  @@map("geonames")
}

/// One row per searchable name variant of a place — its name, asciiname,
/// and every alternatename — normalised (unaccent + lower). Trigram-indexed
/// so a fuzzy transliteration lookup hits any spelling a report might use.
model geonamesName {
  id          BigInt   @id @default(autoincrement())
  geonamesId  Int      @map("geonames_id")
  nameNorm    String   @map("name_norm")
  countryCode String   @map("country_code")

  place       geonames @relation(fields: [geonamesId], references: [geonamesId], onDelete: Cascade)

  @@index([geonamesId])
  @@index([countryCode])
  @@index([nameNorm(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("geonames_name")
}

